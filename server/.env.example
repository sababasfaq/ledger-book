PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Optional: defaults to server/data.sqlite
# DB_PATH=./data.sqlite
# Optional: defaults to server/backups
# BACKUP_DIR=./backups
# Disable only if another process handles backups.
# DISABLE_BACKUP_SCHEDULER=true


# Local AI only. These defaults match npm run ai:setup.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
LOCAL_AI_THREADS=4
LOCAL_AI_USE_GPU=false
# OCR_LANG_PATH=./.local-ai/tessdata
